# --- Dashboard auth (REQUIRED — the console won't run without a password) ---
# HTTP Basic Auth protecting every page and API route. Without this anyone who
# reaches the URL could read drafted comments and lead data, or run
# discovery (spends credits). Pick a strong password.
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=

# --- Data ---
# Absolute path to the shared SQLite DB. The dashboard and `discover` MUST
# use the same file. Defaults to ./data/engagement.db.
DATABASE_PATH=

# --- AI ---
# Long-lived (1-year) token from `claude setup-token`. Authenticates the local
# `claude` CLI, which every classification call is routed through, against the
# client's own Claude subscription instead of a metered API key.
CLAUDE_CODE_OAUTH_TOKEN=
CLAUDE_MODEL=claude-sonnet-5

# --- Discovery (off-account, read-only) ---
# Discovery NEVER uses the client's logged-in accounts. Reading from the account
# is what got a previous build banned. A block on this lane costs a vendor
# credit; a block on the engagement lane costs the account.
#
# Reddit: Arctic Shift, a free unauthenticated Reddit archive. No token needed.
# https://github.com/ArthurHeitmann/arctic_shift
# Hacker News: Algolia's public HN search index. No token needed. https://hn.algolia.com/api
# SocialAPIs.io: Facebook group posts + post search. https://socialapis.io
SOCIALAPIS_TOKEN=

# Posts older than this are not worth commenting on.
MAX_POST_AGE_DAYS=14
# Hard ceiling on classifier calls per discovery pass, so a bad config cannot
# run up an Anthropic bill.
MAX_ANALYZE_PER_RUN=120

# --- Google Sheets activity log ---
# Path to a Google service-account JSON key with edit access to the log sheet
GOOGLE_SERVICE_ACCOUNT_JSON=./config/google-service-account.json
ACTIVITY_LOG_SHEET_ID=

# No automated poster. Approving a candidate opens the real post in a new tab
# and copies the drafted comment to the clipboard; a human pastes it and posts
# it themselves from their own normal, already-logged-in browser. No AdsPower,
# no proxy, no Chrome profile, and no daily posting caps needed for that.
