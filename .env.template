# --- Dashboard auth (REQUIRED — the console won't run without a password) ---
# HTTP Basic Auth protecting every page and API route. Without this anyone who
# reaches the URL could approve comments (they post to real accounts) or run
# discovery (spends credits). Pick a strong password.
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=

# --- Data ---
# Absolute path to the shared SQLite DB. The dashboard, `discover`, and `post`
# worker MUST use the same file. Defaults to ./data/engagement.db.
DATABASE_PATH=

# --- AI ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# --- Discovery ---
# No scraping service / no platform API keys. Discovery reads Reddit/Facebook/
# Instagram through the SAME logged-in Chrome that posts (see CHROME_USER_DATA_DIR
# and PROXY_URL below). Nothing to configure here.

# --- Google Sheets activity log ---
# Path to a Google service-account JSON key with edit access to the log sheet
GOOGLE_SERVICE_ACCOUNT_JSON=./config/google-service-account.json
ACTIVITY_LOG_SHEET_ID=

# --- Browser automation (posting worker) ---
# Persistent Chrome user-data dir holding the logged-in Reddit/FB/IG sessions
CHROME_USER_DATA_DIR=./data/chrome-profile
# Set to "false" on a desktop to watch the browser; "true" on the VPS
HEADLESS=true
# Optional static residential proxy for the VPS, e.g. http://user:pass@host:port
PROXY_URL=

# --- Posting safety caps (per platform, per day) ---
MAX_REDDIT_POSTS_PER_DAY=15
MAX_FACEBOOK_POSTS_PER_DAY=10
MAX_INSTAGRAM_POSTS_PER_DAY=8
# Min/max seconds of human-like delay between actions
ACTION_DELAY_MIN=6
ACTION_DELAY_MAX=18
