# Vercel project env (the frontend + API routes).
# The VPS AI worker has its own separate file — see worker/.env.example.

# --- Dashboard auth (REQUIRED — the console won't run without a password) ---
# HTTP Basic Auth protecting every page and API route. Without this anyone who
# reaches the URL could read drafted comments and lead data, or spend credits.
# Pick a strong password.
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=

# --- Config store (Supabase) ---
# The business context row lives here; Vercel's filesystem is read-only.
# SUPABASE_URL is https://<project-ref>.supabase.co
# Service role key — server-side route handlers only, never shipped to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- AI worker (VPS) ---
# The `claude` CLI cannot run on serverless, so analyzePost() is proxied to a
# small authenticated HTTP worker on the VPS (worker/server.ts).
# AI_WORKER_URL e.g. https://worker.<hon-domain>  (no trailing slash)
# AI_WORKER_SECRET MUST equal the VPS's WORKER_SHARED_SECRET.
AI_WORKER_URL=
AI_WORKER_SECRET=

# --- Sources (off-account, read-only) ---
# Lookups NEVER use the client's logged-in accounts. Reading from the account
# is what got a previous build banned.
#
# Reddit: Arctic Shift, a free unauthenticated Reddit archive. No token needed.
# https://github.com/ArthurHeitmann/arctic_shift
# Hacker News: Algolia's public HN search index. No token needed. https://hn.algolia.com/api
# SocialAPIs.io: Facebook group posts + post search. https://socialapis.io
SOCIALAPIS_TOKEN=

# Posts older than this are not worth commenting on.
MAX_POST_AGE_DAYS=14

# No automated poster. The console drafts comments; a human pastes and posts
# them from their own normal, already-logged-in browser. No AdsPower, no proxy,
# no Chrome profile, and no daily posting caps needed for that.
