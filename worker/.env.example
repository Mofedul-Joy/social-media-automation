# VPS AI worker (worker/server.ts) — copy to worker/.env on the box.
# This is the ONLY part of the system still running on the VPS.

# Long-lived (1-year) token from `claude setup-token`. Authenticates the local
# `claude` CLI, which every classification call is routed through, against the
# client's own Claude subscription instead of a metered API key.
CLAUDE_CODE_OAUTH_TOKEN=
CLAUDE_MODEL=claude-sonnet-5

# Bearer token the Vercel app must present on POST /analyze.
# MUST equal Vercel's AI_WORKER_SECRET.
WORKER_SHARED_SECRET=

# Optional, defaults to 8787. Caddy reverse-proxies to this port.
WORKER_PORT=8787
